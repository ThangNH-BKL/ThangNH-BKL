build _deps\curl-build\docs\examples\CMakeFiles\package.util: CUSTOM_COMMAND _deps\curl-build\docs\examples\all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project_Python\.venv\Copydata\build-ninja && "C:\Program Files\Microsoft Visual Studio\2022\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cpack.exe" --config ./CPackConfig.cmake"
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

